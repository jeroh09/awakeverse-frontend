{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "devCommand": "npm start",
  "installCommand": "npm install",
  "framework": "create-react-app",

  "headers": [
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(js|css|png|jpg|jpeg|gif|ico|svg))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],

  "rewrites": [
    { "source": "/system-management-dashboard-2025",      "destination": "http://138.68.185.51/system-management-dashboard-2025" },
    { "source": "/system-management-dashboard-2025/",     "destination": "http://138.68.185.51/system-management-dashboard-2025/" },
    { "source": "/system-management-dashboard-2025/login","destination": "http://138.68.185.51/system-management-dashboard-2025/login" },
    { "source": "/system-management-dashboard-2025/(.*)", "destination": "http://138.68.185.51/system-management-dashboard-2025/$1" }
  ]
}